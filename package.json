{
  "name": "training-pal",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "postinstall": "pnpm --filter @training-pal/shared build",
    "dev": "concurrently -n client,server -c blue,green \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "pnpm --filter @training-pal/client dev",
    "dev:server": "pnpm --filter @training-pal/server dev",
    "build": "pnpm --filter @training-pal/shared build && pnpm --filter @training-pal/server build && pnpm --filter @training-pal/client build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
